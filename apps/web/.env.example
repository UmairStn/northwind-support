# Copy to .env.local and adjust if you need something other than the defaults.
#   cp .env.example .env.local
# Only variables prefixed with VITE_ are exposed to the browser - never put a
# secret in this file.

# Where the dev server forwards /api requests. Change it if the backend runs on
# another port or host.
VITE_API_PROXY_TARGET=http://localhost:5080

# The base path the app calls the API on. Leave as /api to use the dev proxy;
# set an absolute URL to point a production build at a deployed API.
VITE_API_BASE_URL=/api
